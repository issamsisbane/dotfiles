# ~/.bashrc: executed by bash(1) for non-login shells.

# If not running interactively, don't do anything
case $- in
*i*) ;;
*) return ;;
esac

# don't put duplicate lines or lines starting with space in the history.
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend
HISTSIZE=1000000
HISTFILESIZE=2000000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
  test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
  alias ls='ls --color=auto'
  alias grep='grep --color=auto'
  alias fgrep='fgrep --color=auto'
  alias egrep='egrep --color=auto'
fi

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# enable programmable completion features (needed for e.g. kubectl completion below)
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# SSH agent (only if ssh-agent is available, e.g. not in a minimal devcontainer)
if command -v ssh-agent >/dev/null 2>&1; then
  export SSH_AUTH_SOCK="$HOME/.ssh/ssh-agent.sock"

  # Vérifie si l'agent tourne déjà, sinon le démarre
  ssh-add -q -l &>/dev/null
  if [ $? -eq 2 ]; then
    # Agent mort ou absent → en démarrer un nouveau
    rm -f "$SSH_AUTH_SOCK"
    eval "$(ssh-agent -s -a "$SSH_AUTH_SOCK")" >/dev/null
    [ -f ~/.ssh/homelab ] && ssh-add ~/.ssh/homelab 2>/dev/null
  fi
fi

# Custom Commands
[ -d "$HOME/tools/bash/bin" ] && export PATH="$HOME/tools/bash/bin:$PATH"

# Custom Func
if [ -d "$HOME/tools/bash/func" ]; then
  for script in "$HOME/tools/bash/func/"*.sh; do
    [ -f "$script" ] && source "$script"
  done
fi

# Custom Prompt
PROMPT_COMMAND='PS1_CMD1=$(__git_ps1 " (%s)")'
PS1='\[\e[38;5;45m\]\w\[\e[38;5;220;1m\]${PS1_CMD1}\[\e[0m\] \a\[\e[2m\]\t\n\[\e[0;38;5;155m\]>\[\e[0m\] '

# Custom Aliases
alias k='kubectl'
alias ks='k9s'
alias lg='lazygit'
alias hom='cd ~/dev/homelab'
alias gs='git status'
alias gp='git push'
alias gpl='git pull'
alias ta='tmux attach'

# Vi editing mode in the shell; use nvim as $EDITOR/`vi` only if it's installed
set -o vi
if command -v nvim >/dev/null 2>&1; then
  alias vi='nvim'
  export EDITOR=nvim
fi

# Completion
if command -v kubectl >/dev/null 2>&1; then
  source <(kubectl completion bash)
  complete -o default -F __start_kubectl k
fi

# Vars
export KUBECONFIG=~/.kube/configs/homelab
export do="--dry-run=client -o yaml"

command -v direnv >/dev/null 2>&1 && eval "$(direnv hook bash)"
