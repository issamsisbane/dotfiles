{{- /* Windows-only: link the chezmoi-managed VS Code user files into %APPDATA%\Code\User,
   which lives outside $HOME and so can't be managed by chezmoi directly.
   Re-run automatically by chezmoi whenever the content hash of this template changes. */ -}}
# Content hash (forces re-run on change): {{ include "dot_config/vscode-dotfiles/settings.json" | sha256sum }}

$source = Join-Path $env:USERPROFILE "dot_config\vscode-dotfiles"
$target = Join-Path $env:APPDATA "Code\User"

if (-not (Test-Path $target)) {
    New-Item -ItemType Directory -Path $target -Force | Out-Null
}

$links = @{
    "settings.json"   = "settings.json"
    "keybindings.json" = "keybindings.json"
    "vscode-headings.css" = "vscode-headings.css"
}

foreach ($name in $links.Keys) {
    $src = Join-Path $source $links[$name]
    $dst = Join-Path $target $name

    if (Test-Path $dst) {
        $item = Get-Item $dst -Force
        if ($item.LinkType -ne "SymbolicLink") {
            Remove-Item $dst -Force
        }
    }

    if (-not (Test-Path $dst)) {
        try {
            New-Item -ItemType SymbolicLink -Path $dst -Target $src -Force | Out-Null
        } catch {
            # Fallback when symlink creation isn't allowed (Developer Mode off, no elevation)
            Copy-Item $src $dst -Force
        }
    }
}

$snippetsSrc = Join-Path $source "snippets.json"
$snippetsDir = Join-Path $target "snippets"
if (-not (Test-Path $snippetsDir)) {
    New-Item -ItemType Directory -Path $snippetsDir -Force | Out-Null
}
$snippetsDst = Join-Path $snippetsDir "snippets.json"
if (-not (Test-Path $snippetsDst)) {
    try {
        New-Item -ItemType SymbolicLink -Path $snippetsDst -Target $snippetsSrc -Force | Out-Null
    } catch {
        Copy-Item $snippetsSrc $snippetsDst -Force
    }
}
