{{- /* Windows-only: link the chezmoi-managed Windows Terminal settings.json into the
   package's LocalState folder, which lives outside $HOME and can't be managed by chezmoi
   directly. The package folder name is resolved dynamically (it embeds a hash that can
   change between installs/channels). Re-run automatically whenever the content changes. */ -}}
# Content hash (forces re-run on change): {{ include "dot_config/windows-terminal/settings.json" | sha256sum }}

$source = Join-Path $env:USERPROFILE ".config\windows-terminal\settings.json"

$packageDir = Get-ChildItem "$env:LOCALAPPDATA\Packages" -Filter "Microsoft.WindowsTerminal_*" -Directory |
    Select-Object -First 1

if (-not $packageDir) {
    Write-Warning "Windows Terminal package folder not found, skipping settings link."
    exit 0
}

$target = Join-Path $packageDir.FullName "LocalState\settings.json"

if (Test-Path $target) {
    $item = Get-Item $target -Force
    if ($item.LinkType -ne "SymbolicLink") {
        Remove-Item $target -Force
    }
}

if (-not (Test-Path $target)) {
    try {
        New-Item -ItemType SymbolicLink -Path $target -Target $source -Force -ErrorAction Stop | Out-Null
    } catch {
        # Fallback when symlink creation isn't allowed (Developer Mode off, no elevation)
        Copy-Item $source $target -Force
    }
}
