{{- /* Windows-only: link the chezmoi-managed VS Code user files into %APPDATA%\Code\User,
   which lives outside $HOME and so can't be managed by chezmoi directly.

   This is a plain run_ script (not run_onchange_), so it runs on every
   `chezmoi apply`, not just when the canonical files change.

   Linking strategy, most to least preferred:
     1. Hard link: no special privilege needed on NTFS (unlike symlinks), as
        long as both paths are on the same drive. Both names share the exact
        same file content, so edits through either side are instant and
        `chezmoi diff` just works. This is what actually makes chezmoi
        usable for VS Code config on a locked-down/managed Windows machine.
     2. Symbolic link: needs Developer Mode or elevation; same instant
        two-way behaviour, used as a fallback if hard linking fails (e.g.
        a profile redirected to a different drive).
     3. Plain copy: last resort if neither is available. In that case we
        can't detect an edit made directly in VS Code just by diffing the
        repo, so each run, whichever side (chezmoi's copy, or VS Code's
        real file) was modified most recently wins and is copied onto the
        other - an edit made through the VS Code UI gets pulled back into
        the chezmoi-managed copy (and shows up in `chezmoi diff` / git)
        instead of being silently overwritten next time the repo changes. */ -}}

function Sync-ManagedFile {
    param([string]$Src, [string]$Dst)

    $dstDir = Split-Path $Dst -Parent
    if (-not (Test-Path $dstDir)) {
        New-Item -ItemType Directory -Path $dstDir -Force | Out-Null
    }

    if (Test-Path $Dst) {
        # If $Dst is already a hard/symlink to $Src, both timestamps are
        # identical (it's the same underlying file) and there's nothing to
        # pull back - this only matters in plain-copy mode.
        $dstItem = Get-Item $Dst -Force
        $srcItem = Get-Item $Src -Force
        if ($dstItem.LastWriteTime -gt $srcItem.LastWriteTime) {
            Copy-Item $Dst $Src -Force
        }
        Remove-Item $Dst -Force
    }

    try {
        New-Item -ItemType HardLink -Path $Dst -Target $Src -Force -ErrorAction Stop | Out-Null
        return
    } catch {}

    try {
        New-Item -ItemType SymbolicLink -Path $Dst -Target $Src -Force -ErrorAction Stop | Out-Null
        return
    } catch {}

    Copy-Item $Src $Dst -Force
}

$source = Join-Path $env:USERPROFILE ".config\vscode-dotfiles"
$target = Join-Path $env:APPDATA "Code\User"

$links = @{
    "settings.json"       = "settings.json"
    "keybindings.json"    = "keybindings.json"
    "vscode-headings.css" = "vscode-headings.css"
}

foreach ($name in $links.Keys) {
    Sync-ManagedFile -Src (Join-Path $source $links[$name]) -Dst (Join-Path $target $name)
}

Sync-ManagedFile -Src (Join-Path $source "snippets.json") -Dst (Join-Path $target "snippets\snippets.json")
